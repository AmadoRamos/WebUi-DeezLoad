# Copia este archivo como .env en ESTA carpeta (la que contiene python\ y node\) y rellénalo.
# Lo usan las dos versiones.
TG_API_ID=tu_api_id
TG_API_HASH=tu_api_hash

# Opcionales
DEEZ_BOT=deezload2bot
# Sesión de Telegram de cada versión (cada una la guarda en su carpeta: python\ y node\).
# No uses la misma en las dos: Telegram puede invalidarla.
TG_SESSION=deezload
NODE_SESSION=deezload_node.session
QUIET_SECONDS=3
MAX_WAIT=30
MAX_PAGES=40
# Tras GET ALL: segundos máximos esperando el primer archivo, y segundos sin archivos nuevos
# antes de dar por terminado un álbum al que le faltan pistas
FILES_WAIT=90
FILES_GAP=30
# Segundos de pausa entre álbumes al descargar una discografía completa
DISC_PAUSE=5

# Solo la versión en Node: respaldo ante un bot lento o que responde otra cosa
# Reintentos (volver a pulsar un botón, volver a buscar, empezar de nuevo)
BOT_RETRIES=2
# Segundos esperando a que el bot reaccione antes de volver a pulsar
SLOW_WAIT=15
# Veces que se vuelve a pulsar GET ALL si no llega ningún archivo
GETALL_RETRIES=1
# Si ya tienes parte de un álbum, se piden una a una las que faltan mientras sean como mucho
# estas; si faltan más, GET ALL (el álbum entero). Los tiempos de cada modo quedan en logs/bot.log
UNA_A_UNA_MAX=10
# Máximo de segundos que se espera cuando Telegram pide esperar (FLOOD_WAIT)
FLOOD_MAX_WAIT=300

# Carpeta donde se guardan las descargas (relativa a esta carpeta si no es absoluta)
DOWNLOADS_DIR=downloads
